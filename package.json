{
  "name": "worlds-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.ts",
    "build": "node --experimental-strip-types scripts/build.ts",
    "validate": "node scripts/validate-artifact.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run validate",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy:cloudflare": "wrangler deploy",
    "smoke": "node --experimental-strip-types scripts/smoke.ts"
  },
  "dependencies": {
    "@neon/auth": "0.8.2",
    "jose": "^6.2.15",
    "oauth4webapi": "^3.8.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
