# Public origin must exactly match the deployed host. Never put secrets in hosting.json.
SITE_ORIGIN=https://worlds-hub.maki26.workers.dev
# OIDC remains disabled until every prerequisite in docs/OPERATIONS.md is satisfied.
AUTH_ENABLED=false
# OIDC_ISSUER=https://<dedicated-central-neon-auth-issuer>
# OIDC_CLIENT_ID=<registered-hub-client>
# OIDC_CLIENT_SECRET=<confidential-client-secret>
# OIDC_ID_TOKEN_ALG=RS256
# OIDC_ACCOUNT_URL=https://<verified-provider-account-page>
# PUBLIC_INDEXING=true only after public access is intentionally configured.
PUBLIC_INDEXING=false
# GOOGLE_SITE_VERIFICATION=<public-search-console-token>
# OIDC_RESOURCE=https://worlds-hub.maki26.workers.dev/api
# OIDC_TOKEN_AUTH_METHOD=client_secret_basic
# Migrations require a dedicated test target and per-project public keys. See docs/MIGRATION-RECEIPTS.md.
MIGRATION_RECEIPTS_ENABLED=false
