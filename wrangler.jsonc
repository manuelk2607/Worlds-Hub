{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "worlds-hub",
  "account_id": "ec3c070d8e4f88d2fc533d7d797f2daa",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "logpush": false,
  "build": {"command":"npm run build"},
  "vars": {
    "SITE_ORIGIN":"https://worlds-hub.maki26.workers.dev",
    "AUTH_ENABLED":"false",
    "OIDC_REAUTH_ENABLED":"false",
    "PUBLIC_INDEXING":"true"
  }
  // No database, paid service or auth binding is created by this deployment.
  // Before SSO activation: dedicated AUTH_DB, migrations and provider pilot acceptance.
}
